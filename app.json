{
  "expo": {
    "name": "Lifely",
    "slug": "lifely",
    "scheme": "lifely",
    "version": "1.23.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.xavierff.lifely",
      "supportsTablet": true,
      "buildNumber": "33"
    },
    "android": {
      "package": "com.xavierff.lifely",
      "versionCode": 33,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101C1B"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "icon": "./assets/icon.png"
  }
}
