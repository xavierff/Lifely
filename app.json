{
  "expo": {
    "name": "Lifely",
    "slug": "lifely",
    "scheme": "lifely",
    "version": "1.4.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "plugins": [["expo-audio", {"recordAudioAndroid": false, "enableBackgroundPlayback": false}]],
    "ios": {
      "bundleIdentifier": "com.xavierff.lifely",
      "supportsTablet": true,
      "buildNumber": "14"
    },
    "android": {
      "package": "com.xavierff.lifely",
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101C1B"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "icon": "./assets/icon.png"
  }
}
